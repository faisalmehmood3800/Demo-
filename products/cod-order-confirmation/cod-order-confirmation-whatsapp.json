      "position": [
        0,
        0
      ],
      "webhookId": "09265c83-e184-4cf1-9627-65e1b1e5105b"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "10e0289a-9166-45dd-9b65-5081e6c03566",
              "name": "store_name",
              "value": "Your Store Name",
              "type": "string"
            },
            {
              "id": "f2afe064-0777-4b76-bd0b-43244e274c4d",
              "name": "template_name",
              "value": "order_confirmation",
              "type": "string"
            },
            {
              "id": "73a0e33a-b963-4367-89d2-c2ed699ff6b6",
              "name": "template_language",
              "value": "en",
              "type": "string"
            },
            {
              "id": "e2304dc4-59fd-4d43-8ac6-0957fc447ed4",
              "name": "whatsapp_phone_number_id",
              "value": "PASTE_YOUR_PHONE_NUMBER_ID",
              "type": "string"
            },
            {
              "id": "65b32adb-9f61-4201-bb7c-39838cd30f7d",
              "name": "default_country_code",
              "value": "92",
              "type": "string"
            },
            {
              "id": "f150d78a-0419-4cfc-beaa-7840ad798ac5",
              "name": "cod_only",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "2db56363-36ba-45d5-98ca-a1a04066a7ea",
      "name": "Store settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "783c5887-3de3-4ee4-8e62-128a05f3129d",
              "name": "orderId",
              "value": "={{ String($json.id) }}",
              "type": "string"
            },
            {
              "id": "23513570-af23-42e2-88d0-31ca3cdc95af",
              "name": "orderName",
              "value": "={{ $json.name }}",
              "type": "string"
            },
            {
              "id": "f5213de3-f8cb-442b-bbb1-a64381520567",
              "name": "customerName",
              "value": "={{ ($json.shipping_address?.first_name || $json.customer?.first_name || 'Customer').trim() }}",
              "type": "string"
            },
            {
              "id": "81bc7ef1-3c9b-4f6e-8340-0f8b3f195dea",
              "name": "phone",
              "value": "={{ (() => { const cc = $('Store settings').item.json.default_country_code; let p = String($json.shipping_address?.phone || $json.billing_address?.phone || $json.phone || $json.customer?.phone || '').replace(/\\D/g, ''); if (p.startsWith('00')) p = p.slice(2); if (p.startsWith('0')) p = cc + p.slice(1); else if (p.length === 10 && p.startsWith('3')) p = cc + p; return p; })() }}",
              "type": "string"
            },
            {
              "id": "2e4287cf-0e88-4d57-beb2-4f5ff419d1b3",
              "name": "items",
              "value": "={{ ($json.line_items || []).map(i => i.quantity + ' x ' + i.title + (i.variant_title ? ' (' + i.variant_title + ')' : '')).join(', ').slice(0, 200) }}",
              "type": "string"
            },
            {
              "id": "25beca47-2d12-40c3-922f-e0d49b6fa483",
              "name": "total",
              "value": "={{ 'Rs ' + Number($json.total_price || 0).toLocaleString('en-US') }}",
              "type": "string"
            },
            {
              "id": "ecc3af60-566a-4498-9f58-8692184b659a",
              "name": "shopTags",
              "value": "={{ $json.tags || '' }}",
              "type": "string"
            },
            {
              "id": "8ed8b27b-c02f-48fd-a335-8b00b0084f64",
              "name": "isCod",
              "value": "={{ ($json.payment_gateway_names || []).join(' ').toLowerCase().includes('cash') || ($json.payment_gateway_names || []).join(' ').toLowerCase().includes('cod') || $json.financial_status === 'pending' }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "855fb83c-4c61-43d9-882d-2eadcadc1d1a",
      "name": "Prepare order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "5b973e22-8f68-4a37-ab14-6a9681813f44",
              "leftValue": "={{ $json.phone.length >= 11 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "674ccaf8-83f4-401c-8e5e-247158156bc3",
              "leftValue": "={{ !$('Store settings').item.json.cod_only || $json.isCod }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
